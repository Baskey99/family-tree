{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile metadata owned strictly by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "username": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "displayName", "username", "email", "createdAt", "updatedAt"]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Exact-key username to email lookup for username login and inviting family members by username.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "email", "createdAt"]
    },
    "TreeInvite": {
      "title": "TreeInvite",
      "description": "Private invitation granting a family member viewer or editor access to a specific family tree.",
      "type": "object",
      "properties": {
        "treeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "treeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "inviteeEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "role": { "type": "string", "enum": ["viewer", "editor"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["treeId", "treeName", "ownerId", "ownerName", "inviteeEmail", "role", "createdAt", "updatedAt"]
    },
    "TreeMembership": {
      "title": "TreeMembership",
      "description": "Active RBAC access grant connecting an invited family member (viewer or editor) to a shared family tree.",
      "type": "object",
      "properties": {
        "treeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "treeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "userName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "role": { "type": "string", "enum": ["viewer", "editor"] },
        "inviteId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["treeId", "treeName", "ownerId", "ownerName", "userId", "userEmail", "userName", "role", "inviteId", "createdAt", "updatedAt"]
    },
    "FamilyTree": {
      "title": "FamilyTree",
      "description": "Private family tree workspace owned by a user and optionally shared with invited family members.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "ownerEmail": { "type": "string", "minLength": 0, "maxLength": 254 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "description", "createdAt", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "A profile record for a single individual within a family tree.",
      "type": "object",
      "properties": {
        "treeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "dateOfBirth": { "type": "string", "minLength": 0, "maxLength": 32 },
        "manualAge": { "type": "number" },
        "address": { "type": "string", "minLength": 0, "maxLength": 250 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 65000 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["treeId", "ownerId", "fullName", "gender", "dateOfBirth", "manualAge", "address", "photoUrl", "notes", "createdAt", "updatedAt"]
    },
    "TreeLinkRequest": {
      "title": "TreeLinkRequest",
      "description": "Pending cross-user family tree connection request requiring explicit recipient consent for view or edit access.",
      "type": "object",
      "properties": {
        "sourceTreeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceTreeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceOwnerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "sourceOwnerEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "sourceMemberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceMemberName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "sourceGrantsRole": { "type": "string", "enum": ["viewer", "editor"] },
        "targetEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "relationshipType": { "type": "string", "enum": ["parent_child", "spouse", "sibling", "cousin", "other"] },
        "relationshipDirection": { "type": "string", "enum": ["mutual", "source_is_parent", "target_is_parent"] },
        "customLabel": { "type": "string", "minLength": 0, "maxLength": 80 },
        "note": { "type": "string", "minLength": 0, "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "sourceTreeId",
        "sourceTreeName",
        "sourceOwnerId",
        "sourceOwnerName",
        "sourceOwnerEmail",
        "sourceMemberId",
        "sourceMemberName",
        "sourceGrantsRole",
        "targetEmail",
        "relationshipType",
        "relationshipDirection",
        "customLabel",
        "note",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "TreeConnection": {
      "title": "TreeConnection",
      "description": "Mutually consented bridge linking two members across two different users' family trees with independent view/edit roles.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceTreeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceTreeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceOwnerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "sourceOwnerEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "sourceMemberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceMemberName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "sourceGrantsRole": { "type": "string", "enum": ["viewer", "editor"] },
        "targetTreeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetTreeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetOwnerName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "targetOwnerEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "targetMemberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetMemberName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "targetGrantsRole": { "type": "string", "enum": ["viewer", "editor"] },
        "participantIds": { "type": "array", "description": "Bounded 2-element list [sourceOwnerId, targetOwnerId] for secure participant queries." },
        "relationshipType": { "type": "string", "enum": ["parent_child", "spouse", "sibling", "cousin", "other"] },
        "relationshipDirection": { "type": "string", "enum": ["mutual", "source_is_parent", "target_is_parent"] },
        "customLabel": { "type": "string", "minLength": 0, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestId",
        "sourceTreeId",
        "sourceTreeName",
        "sourceOwnerId",
        "sourceOwnerName",
        "sourceOwnerEmail",
        "sourceMemberId",
        "sourceMemberName",
        "sourceGrantsRole",
        "targetTreeId",
        "targetTreeName",
        "targetOwnerId",
        "targetOwnerName",
        "targetOwnerEmail",
        "targetMemberId",
        "targetMemberName",
        "targetGrantsRole",
        "participantIds",
        "relationshipType",
        "relationshipDirection",
        "customLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "FamilyRelationship": {
      "title": "FamilyRelationship",
      "description": "A relationship edge connecting two members within a family tree.",
      "type": "object",
      "properties": {
        "treeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "personId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "relatedPersonId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "relationshipType": { "type": "string", "enum": ["parent_child", "spouse", "sibling", "cousin", "other"] },
        "customLabel": { "type": "string", "minLength": 0, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["treeId", "ownerId", "personId", "relatedPersonId", "relationshipType", "customLabel", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles accessible only to the owning user."
    },
    "/usernames/{usernameKey}": {
      "schema": { "$ref": "#/entities/UsernameLookup" },
      "description": "Exact-key username lookup for login and username-based family invitations."
    },
    "/tree_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/TreeInvite" },
      "description": "Pending family tree invitations readable only by the tree owner and invited email."
    },
    "/tree_memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/TreeMembership" },
      "description": "Active viewer/editor memberships enforcing family-only access isolation."
    },
    "/tree_link_requests/{requestId}": {
      "schema": { "$ref": "#/entities/TreeLinkRequest" },
      "description": "Cross-user tree connection consent requests readable only by sender and recipient."
    },
    "/tree_connections/{connectionId}": {
      "schema": { "$ref": "#/entities/TreeConnection" },
      "description": "Active mutually consented bridges connecting members across separate users' family trees."
    },
    "/family_trees/{treeId}": {
      "schema": { "$ref": "#/entities/FamilyTree" },
      "description": "Private family trees accessible strictly to owner and invited family members."
    },
    "/family_trees/{treeId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Family members readable by owner/viewer/editor and writable only by owner/editor."
    },
    "/family_trees/{treeId}/relationships/{relationshipId}": {
      "schema": { "$ref": "#/entities/FamilyRelationship" },
      "description": "Family relationships readable by owner/viewer/editor and writable only by owner/editor."
    }
  }
}
