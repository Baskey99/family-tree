rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameKey(key) {
      return key is string && key.size() >= 2 && key.size() <= 40 && key.matches('^[a-z0-9_\\-]+$');
    }

    function isValidRole(role) {
      return role is string && (role == 'viewer' || role == 'editor');
    }

    function isValidEmail(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 254
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() <= 65000
        && (
          url == '' ||
          url.matches('^https://[^\\s]+$') ||
          url.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function currentUserEmail() {
      return ('email' in request.auth.token && request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : '';
    }

    function treeDoc(treeId) {
      return get(/databases/$(database)/documents/family_trees/$(treeId));
    }

    function treeExists(treeId) {
      return exists(/databases/$(database)/documents/family_trees/$(treeId));
    }

    function isTreeOwner(treeId) {
      return isSignedIn() && treeExists(treeId) && treeDoc(treeId).data.ownerId == request.auth.uid;
    }

    function membershipPath(treeId, uid) {
      return /databases/$(database)/documents/tree_memberships/$(treeId + '__' + uid);
    }

    function hasTreeMembership(treeId) {
      return isSignedIn() && exists(membershipPath(treeId, request.auth.uid));
    }

    function getTreeMembershipRole(treeId) {
      return get(membershipPath(treeId, request.auth.uid)).data.role;
    }

    function canReadTree(treeId) {
      return isSignedIn() && (
        isTreeOwner(treeId) ||
        hasTreeMembership(treeId)
      );
    }

    function canEditTree(treeId) {
      return isSignedIn() && (
        isTreeOwner(treeId) ||
        (hasTreeMembership(treeId) && getTreeMembershipRole(treeId) == 'editor')
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'username', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'username', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidUsernameKey(data.username)
        && isValidEmail(data.email)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsernameLookup(data) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidEmail(data.email)
        && data.createdAt is timestamp;
    }

    function isValidFamilyTree(data) {
      return data.keys().hasAll(['ownerId', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'ownerName', 'ownerEmail', 'name', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120))
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 254))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTreeInvite(data) {
      return data.keys().hasAll([
          'treeId', 'treeName', 'ownerId', 'ownerName',
          'inviteeEmail', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'treeId', 'treeName', 'ownerId', 'ownerName',
          'inviteeEmail', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.treeId)
        && data.treeName is string && data.treeName.size() >= 1 && data.treeName.size() <= 120
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerName is string && data.ownerName.size() <= 120
        && isValidEmail(data.inviteeEmail)
        && data.inviteeEmail == data.inviteeEmail.lower()
        && isValidRole(data.role)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTreeMembership(data, membershipId) {
      return data.keys().hasAll([
          'treeId', 'treeName', 'ownerId', 'ownerName',
          'userId', 'userEmail', 'userName', 'role', 'inviteId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'treeId', 'treeName', 'ownerId', 'ownerName',
          'userId', 'userEmail', 'userName', 'role', 'inviteId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.treeId)
        && data.treeName is string && data.treeName.size() >= 1 && data.treeName.size() <= 120
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() <= 120
        && isValidId(data.userId)
        && data.userId != data.ownerId
        && membershipId == data.treeId + '__' + data.userId
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.userName is string && data.userName.size() <= 120
        && isValidRole(data.role)
        && data.inviteId is string && data.inviteId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidManualAge(age) {
      return age == null || ((age is int || age is float) && age >= 0 && age <= 130);
    }

    function isValidFamilyMember(data, treeId) {
      return data.keys().hasAll([
          'treeId', 'ownerId', 'fullName', 'gender',
          'dateOfBirth', 'manualAge', 'address', 'photoUrl', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'treeId', 'ownerId', 'fullName', 'gender',
          'dateOfBirth', 'manualAge', 'address', 'photoUrl', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.treeId)
        && data.treeId == treeId
        && isValidId(data.ownerId)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 140
        && data.gender is string && (data.gender == 'male' || data.gender == 'female')
        && data.dateOfBirth is string && data.dateOfBirth.size() <= 32
        && isValidManualAge(data.manualAge)
        && data.address is string && data.address.size() <= 250
        && isValidPhotoUrl(data.photoUrl)
        && data.notes is string && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRelationshipType(relType) {
      return relType is string && (
        relType == 'parent_child' ||
        relType == 'spouse' ||
        relType == 'sibling' ||
        relType == 'cousin' ||
        relType == 'other'
      );
    }

    function isValidFamilyRelationship(data, treeId) {
      return data.keys().hasAll([
          'treeId', 'ownerId', 'personId', 'relatedPersonId',
          'relationshipType', 'customLabel', 'createdAt'
        ])
        && data.keys().hasOnly([
          'treeId', 'ownerId', 'personId', 'relatedPersonId',
          'relationshipType', 'customLabel', 'createdAt'
        ])
        && isValidId(data.treeId)
        && data.treeId == treeId
        && isValidId(data.ownerId)
        && isValidId(data.personId)
        && isValidId(data.relatedPersonId)
        && data.personId != data.relatedPersonId
        && isValidRelationshipType(data.relationshipType)
        && data.customLabel is string && data.customLabel.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidLinkDirection(dir) {
      return dir is string && (
        dir == 'mutual' ||
        dir == 'source_is_parent' ||
        dir == 'target_is_parent'
      );
    }

    function isValidLinkStatus(status) {
      return status is string && (
        status == 'pending' ||
        status == 'accepted' ||
        status == 'declined'
      );
    }

    function isValidTreeLinkRequest(data) {
      return data.keys().hasAll([
          'sourceTreeId', 'sourceTreeName', 'sourceOwnerId', 'sourceOwnerName',
          'sourceOwnerEmail', 'sourceMemberId', 'sourceMemberName', 'sourceGrantsRole',
          'targetEmail', 'relationshipType', 'relationshipDirection',
          'customLabel', 'note', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'sourceTreeId', 'sourceTreeName', 'sourceOwnerId', 'sourceOwnerName',
          'sourceOwnerEmail', 'sourceMemberId', 'sourceMemberName', 'sourceGrantsRole',
          'targetEmail', 'relationshipType', 'relationshipDirection',
          'customLabel', 'note', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.sourceTreeId)
        && data.sourceTreeName is string && data.sourceTreeName.size() >= 1 && data.sourceTreeName.size() <= 120
        && isValidId(data.sourceOwnerId)
        && data.sourceOwnerName is string && data.sourceOwnerName.size() <= 120
        && isValidEmail(data.sourceOwnerEmail)
        && data.sourceOwnerEmail == data.sourceOwnerEmail.lower()
        && isValidId(data.sourceMemberId)
        && data.sourceMemberName is string && data.sourceMemberName.size() >= 1 && data.sourceMemberName.size() <= 140
        && isValidRole(data.sourceGrantsRole)
        && isValidEmail(data.targetEmail)
        && data.targetEmail == data.targetEmail.lower()
        && isValidRelationshipType(data.relationshipType)
        && isValidLinkDirection(data.relationshipDirection)
        && data.customLabel is string && data.customLabel.size() <= 80
        && data.note is string && data.note.size() <= 300
        && isValidLinkStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTreeConnection(data) {
      return data.keys().hasAll([
          'requestId',
          'sourceTreeId', 'sourceTreeName', 'sourceOwnerId', 'sourceOwnerName',
          'sourceOwnerEmail', 'sourceMemberId', 'sourceMemberName', 'sourceGrantsRole',
          'targetTreeId', 'targetTreeName', 'targetOwnerId', 'targetOwnerName',
          'targetOwnerEmail', 'targetMemberId', 'targetMemberName', 'targetGrantsRole',
          'participantIds', 'relationshipType', 'relationshipDirection',
          'customLabel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId',
          'sourceTreeId', 'sourceTreeName', 'sourceOwnerId', 'sourceOwnerName',
          'sourceOwnerEmail', 'sourceMemberId', 'sourceMemberName', 'sourceGrantsRole',
          'targetTreeId', 'targetTreeName', 'targetOwnerId', 'targetOwnerName',
          'targetOwnerEmail', 'targetMemberId', 'targetMemberName', 'targetGrantsRole',
          'participantIds', 'relationshipType', 'relationshipDirection',
          'customLabel', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && isValidId(data.sourceTreeId)
        && data.sourceTreeName is string && data.sourceTreeName.size() >= 1 && data.sourceTreeName.size() <= 120
        && isValidId(data.sourceOwnerId)
        && data.sourceOwnerName is string && data.sourceOwnerName.size() <= 120
        && isValidEmail(data.sourceOwnerEmail)
        && data.sourceOwnerEmail == data.sourceOwnerEmail.lower()
        && isValidId(data.sourceMemberId)
        && data.sourceMemberName is string && data.sourceMemberName.size() >= 1 && data.sourceMemberName.size() <= 140
        && isValidRole(data.sourceGrantsRole)
        && isValidId(data.targetTreeId)
        && data.targetTreeId != data.sourceTreeId
        && data.targetTreeName is string && data.targetTreeName.size() >= 1 && data.targetTreeName.size() <= 120
        && isValidId(data.targetOwnerId)
        && data.targetOwnerId != data.sourceOwnerId
        && data.targetOwnerName is string && data.targetOwnerName.size() <= 120
        && isValidEmail(data.targetOwnerEmail)
        && data.targetOwnerEmail == data.targetOwnerEmail.lower()
        && isValidId(data.targetMemberId)
        && data.targetMemberName is string && data.targetMemberName.size() >= 1 && data.targetMemberName.size() <= 140
        && isValidRole(data.targetGrantsRole)
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] == data.sourceOwnerId
        && data.participantIds[1] == data.targetOwnerId
        && isValidRelationshipType(data.relationshipType)
        && isValidLinkDirection(data.relationshipDirection)
        && data.customLabel is string && data.customLabel.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} (strictly private to owner) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming(), userId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // --- Collection: /usernames/{usernameKey} (exact-key login lookup, list denied) ---
    match /usernames/{usernameKey} {
      allow get: if isValidUsernameKey(usernameKey);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidUsernameKey(usernameKey)
        && !exists(/databases/$(database)/documents/usernames/$(usernameKey))
        && isValidUsernameLookup(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isSignedIn()
        && isValidUsernameKey(usernameKey)
        && existing().ownerId == request.auth.uid;
    }

    // --- Collection: /tree_invites/{inviteId} (private invitations between owner & invitee) ---
    match /tree_invites/{inviteId} {
      allow get: if isSignedIn()
        && isValidId(inviteId)
        && (existing().ownerId == request.auth.uid || existing().inviteeEmail == currentUserEmail());

      allow list: if isSignedIn()
        && (existing().ownerId == request.auth.uid || existing().inviteeEmail == currentUserEmail());

      allow create: if isSignedIn()
        && isValidId(inviteId)
        && isValidTreeInvite(incoming())
        && incoming().inviteeEmail != currentUserEmail()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTreeOwner(incoming().treeId);

      allow update: if isSignedIn()
        && isValidId(inviteId)
        && isValidTreeInvite(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().treeId == existing().treeId
        && incoming().inviteeEmail == existing().inviteeEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'treeName', 'updatedAt'])
        && isTreeOwner(existing().treeId);

      allow delete: if isSignedIn()
        && isValidId(inviteId)
        && (existing().ownerId == request.auth.uid || existing().inviteeEmail == currentUserEmail());
    }

    // --- Collection: /tree_memberships/{membershipId} (RBAC access grants: viewer / editor) ---
    match /tree_memberships/{membershipId} {
      allow get: if isSignedIn()
        && isValidId(membershipId)
        && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);

      allow list: if isSignedIn()
        && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(membershipId)
        && isValidTreeMembership(incoming(), membershipId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Action 1: Tree owner grants access directly
          (incoming().ownerId == request.auth.uid && isTreeOwner(incoming().treeId)) ||
          // Action 2: Invited family member accepts a valid owner-created invite
          (
            incoming().userId == request.auth.uid
            && incoming().userEmail == currentUserEmail()
            && isValidId(incoming().inviteId)
            && exists(/databases/$(database)/documents/tree_invites/$(incoming().inviteId))
            && get(/databases/$(database)/documents/tree_invites/$(incoming().inviteId)).data.treeId == incoming().treeId
            && get(/databases/$(database)/documents/tree_invites/$(incoming().inviteId)).data.ownerId == incoming().ownerId
            && get(/databases/$(database)/documents/tree_invites/$(incoming().inviteId)).data.role == incoming().role
            && get(/databases/$(database)/documents/tree_invites/$(incoming().inviteId)).data.inviteeEmail == currentUserEmail()
          ) ||
          // Action 3: Recipient accepts a valid pending cross-user tree connection request
          (
            incoming().userId == request.auth.uid
            && incoming().userEmail == currentUserEmail()
            && isValidId(incoming().inviteId)
            && exists(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId))
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.status == 'pending'
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceTreeId == incoming().treeId
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceOwnerId == incoming().ownerId
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceGrantsRole == incoming().role
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.targetEmail == currentUserEmail()
          )
        );

      allow update: if isSignedIn()
        && isValidId(membershipId)
        && isValidTreeMembership(incoming(), membershipId)
        && incoming().ownerId == existing().ownerId
        && incoming().treeId == existing().treeId
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Tree owner updates collaborator permission or tree name
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'treeName', 'inviteId', 'updatedAt'])
            && isTreeOwner(existing().treeId)
          ) ||
          // Action 2: Recipient updates existing membership via a newly accepted tree connection request
          (
            existing().userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'treeName', 'inviteId', 'updatedAt'])
            && isValidId(incoming().inviteId)
            && exists(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId))
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.status == 'pending'
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceTreeId == existing().treeId
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceOwnerId == existing().ownerId
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.sourceGrantsRole == incoming().role
            && get(/databases/$(database)/documents/tree_link_requests/$(incoming().inviteId)).data.targetEmail == currentUserEmail()
          )
        );

      allow delete: if isSignedIn()
        && isValidId(membershipId)
        && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);
    }

    // --- Collection: /tree_link_requests/{requestId} (cross-user consent requests) ---
    match /tree_link_requests/{requestId} {
      allow get: if isSignedIn()
        && isValidId(requestId)
        && (existing().sourceOwnerId == request.auth.uid || existing().targetEmail == currentUserEmail());

      allow list: if isSignedIn()
        && (existing().sourceOwnerId == request.auth.uid || existing().targetEmail == currentUserEmail());

      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidTreeLinkRequest(incoming())
        && incoming().sourceOwnerId == request.auth.uid
        && incoming().sourceOwnerEmail == currentUserEmail()
        && incoming().targetEmail != currentUserEmail()
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTreeOwner(incoming().sourceTreeId)
        && exists(/databases/$(database)/documents/family_trees/$(incoming().sourceTreeId)/members/$(incoming().sourceMemberId));

      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidTreeLinkRequest(incoming())
        && existing().status == 'pending'
        && existing().targetEmail == currentUserEmail()
        && (incoming().status == 'accepted' || incoming().status == 'declined')
        && incoming().sourceTreeId == existing().sourceTreeId
        && incoming().sourceTreeName == existing().sourceTreeName
        && incoming().sourceOwnerId == existing().sourceOwnerId
        && incoming().sourceOwnerName == existing().sourceOwnerName
        && incoming().sourceOwnerEmail == existing().sourceOwnerEmail
        && incoming().sourceMemberId == existing().sourceMemberId
        && incoming().sourceMemberName == existing().sourceMemberName
        && incoming().sourceGrantsRole == existing().sourceGrantsRole
        && incoming().targetEmail == existing().targetEmail
        && incoming().relationshipType == existing().relationshipType
        && incoming().relationshipDirection == existing().relationshipDirection
        && incoming().customLabel == existing().customLabel
        && incoming().note == existing().note
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(requestId)
        && (existing().sourceOwnerId == request.auth.uid || existing().targetEmail == currentUserEmail());
    }

    // --- Collection: /tree_connections/{connectionId} (active mutually-consented tree bridges) ---
    match /tree_connections/{connectionId} {
      allow get: if isSignedIn()
        && isValidId(connectionId)
        && (existing().sourceOwnerId == request.auth.uid || existing().targetOwnerId == request.auth.uid);

      allow list: if isSignedIn()
        && request.auth.uid in existing().participantIds;

      allow create: if isSignedIn()
        && isValidId(connectionId)
        && isValidTreeConnection(incoming())
        && incoming().targetOwnerId == request.auth.uid
        && incoming().targetOwnerEmail == currentUserEmail()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTreeOwner(incoming().targetTreeId)
        && exists(/databases/$(database)/documents/family_trees/$(incoming().targetTreeId)/members/$(incoming().targetMemberId))
        && exists(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId))
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.status == 'pending'
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.targetEmail == currentUserEmail()
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.sourceTreeId == incoming().sourceTreeId
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.sourceOwnerId == incoming().sourceOwnerId
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.sourceMemberId == incoming().sourceMemberId
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.sourceGrantsRole == incoming().sourceGrantsRole
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.relationshipType == incoming().relationshipType
        && get(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.relationshipDirection == incoming().relationshipDirection
        && getAfter(/databases/$(database)/documents/tree_link_requests/$(incoming().requestId)).data.status == 'accepted';

      allow update: if isSignedIn()
        && isValidId(connectionId)
        && isValidTreeConnection(incoming())
        && incoming().requestId == existing().requestId
        && incoming().sourceTreeId == existing().sourceTreeId
        && incoming().sourceTreeName == existing().sourceTreeName
        && incoming().sourceOwnerId == existing().sourceOwnerId
        && incoming().sourceOwnerName == existing().sourceOwnerName
        && incoming().sourceOwnerEmail == existing().sourceOwnerEmail
        && incoming().sourceMemberId == existing().sourceMemberId
        && incoming().sourceMemberName == existing().sourceMemberName
        && incoming().targetTreeId == existing().targetTreeId
        && incoming().targetTreeName == existing().targetTreeName
        && incoming().targetOwnerId == existing().targetOwnerId
        && incoming().targetOwnerName == existing().targetOwnerName
        && incoming().targetOwnerEmail == existing().targetOwnerEmail
        && incoming().targetMemberId == existing().targetMemberId
        && incoming().targetMemberName == existing().targetMemberName
        && incoming().participantIds == existing().participantIds
        && incoming().relationshipType == existing().relationshipType
        && incoming().relationshipDirection == existing().relationshipDirection
        && incoming().customLabel == existing().customLabel
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Source owner updates view/edit consent on their own tree
          (
            existing().sourceOwnerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['sourceGrantsRole', 'updatedAt'])
          ) ||
          // Action 2: Target owner updates view/edit consent on their own tree
          (
            existing().targetOwnerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['targetGrantsRole', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(connectionId)
        && (existing().sourceOwnerId == request.auth.uid || existing().targetOwnerId == request.auth.uid);
    }

    // --- Collection: /family_trees/{treeId} (strictly isolated to owner + invited family members) ---
    match /family_trees/{treeId} {
      allow get: if isSignedIn()
        && isValidId(treeId)
        && (existing().ownerId == request.auth.uid || hasTreeMembership(treeId));

      // Owners list their own trees; shared members discover shared trees via /tree_memberships
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(treeId)
        && isValidFamilyTree(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(treeId)
        && isValidFamilyTree(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(treeId)
        && existing().ownerId == request.auth.uid;

      // --- Subcollection: /family_trees/{treeId}/members/{memberId} ---
      match /members/{memberId} {
        allow get: if isSignedIn()
          && isValidId(treeId)
          && isValidId(memberId)
          && canReadTree(treeId);

        allow list: if isSignedIn()
          && isValidId(treeId)
          && canReadTree(treeId);

        allow create: if isSignedIn()
          && isValidId(treeId)
          && isValidId(memberId)
          && isValidFamilyMember(incoming(), treeId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && canEditTree(treeId)
          && incoming().ownerId == treeDoc(treeId).data.ownerId;

        allow update: if isSignedIn()
          && isValidId(treeId)
          && isValidId(memberId)
          && isValidFamilyMember(incoming(), treeId)
          && incoming().ownerId == existing().ownerId
          && incoming().treeId == existing().treeId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'gender', 'dateOfBirth', 'manualAge',
            'address', 'photoUrl', 'notes', 'updatedAt'
          ])
          && canEditTree(treeId);

        allow delete: if isSignedIn()
          && isValidId(treeId)
          && isValidId(memberId)
          && canEditTree(treeId);
      }

      // --- Subcollection: /family_trees/{treeId}/relationships/{relationshipId} ---
      match /relationships/{relationshipId} {
        allow get: if isSignedIn()
          && isValidId(treeId)
          && isValidId(relationshipId)
          && canReadTree(treeId);

        allow list: if isSignedIn()
          && isValidId(treeId)
          && canReadTree(treeId);

        allow create: if isSignedIn()
          && isValidId(treeId)
          && isValidId(relationshipId)
          && isValidFamilyRelationship(incoming(), treeId)
          && incoming().createdAt == request.time
          && canEditTree(treeId)
          && incoming().ownerId == treeDoc(treeId).data.ownerId;

        allow update: if isSignedIn()
          && isValidId(treeId)
          && isValidId(relationshipId)
          && isValidFamilyRelationship(incoming(), treeId)
          && incoming().ownerId == existing().ownerId
          && incoming().treeId == existing().treeId
          && incoming().personId == existing().personId
          && incoming().relatedPersonId == existing().relatedPersonId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['relationshipType', 'customLabel'])
          && canEditTree(treeId);

        allow delete: if isSignedIn()
          && isValidId(treeId)
          && isValidId(relationshipId)
          && canEditTree(treeId);
      }
    }
  }
}
